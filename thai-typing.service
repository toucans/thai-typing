# Thai typing trainer -- stdlib Go server, installed by install.sh.
[Unit]
Description=Thai typing trainer (thai-typing)
After=network.target

[Service]
Type=simple
User=johan
WorkingDirectory=/home/johan/thai-typing
# Durable user data lives under the box's ~/keep/<project> convention (backed up
# via ~/keep), not in the repo. See the thai-typing README + debian-config Backups.
ExecStart=/home/johan/thai-typing/thai-typing-go -data /home/johan/keep/thai-typing
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
