# Thai typing trainer -- stdlib Go server, installed by install.sh.
[Unit]
Description=Thai typing trainer (thai-typing)
After=network.target

[Service]
Type=simple
User=johan
WorkingDirectory=/home/johan/thai-typing
ExecStart=/home/johan/thai-typing/thai-typing-go
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
