# Thai typing trainer -- stdlib Python server, installed by install.sh.
[Unit]
Description=Thai typing trainer (thai-typing)
After=network.target

[Service]
Type=simple
User=johan
WorkingDirectory=/home/johan/thai-typing
ExecStart=/usr/bin/python3 /home/johan/thai-typing/server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
